    <!-- Part 10: onboarding / settings / export / cloud -->
    <string name="onboard_skip">Skip</string>
    <string name="onboard_next">Next</string>
    <string name="onboard_get_started">Get started</string>
    <string name="onboard_1_title">Map Wi‑Fi in AR</string>
    <string name="onboard_1_body">WifiAR walks with you, measures signal strength of nearby networks, and paints a live heatmap over the real room using ARCore.</string>
    <string name="onboard_2_title">Why location permission?</string>
    <string name="onboard_2_body">Android requires location permission to access WiFi signal data (RSSI). We use it to measure networks — not to track you. Camera is needed for AR.</string>
    <string name="onboard_3_title">How to scan well</string>
    <string name="onboard_3_body">Start a session, walk slowly, and cover every corner. Pause a few seconds so scans can finish (Android throttles WiFi scans). More samples = better heatmaps.</string>
    <string name="onboard_4_title">Explore insights</string>
    <string name="onboard_4_body">Find dead zones, compare networks, run speed tests, get a router placement suggestion, export PNG/CSV, and optionally sync to the backend.</string>

