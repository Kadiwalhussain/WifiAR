<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WifiAR" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#070B12</item>
        <item name="android:navigationBarColor">#070B12</item>
        <item name="android:windowBackground">#070B12</item>
        <item name="android:colorPrimary">#00E5FF</item>
        <item name="android:windowLightStatusBar">false</item>
